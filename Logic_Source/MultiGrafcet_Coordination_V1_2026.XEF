	<program>
		<identProgram name="FREEZE" type="section" task="MAST" SectionOrder="5"></identProgram>
		<STSource>(* Figer G2 quand Run_G2 = 0 → maître en E2 *)
G2Frozen := FREEZECHART(G2, NOT Run_G2);
</STSource>
	</program>
	<program>

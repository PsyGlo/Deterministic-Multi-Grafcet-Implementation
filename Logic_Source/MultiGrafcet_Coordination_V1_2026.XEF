	<EFSource nameOfEFType="FREEZECHART" version="1.00" dateTime="dt#2020-10-16-14:44:19">
		<comment>Freeze a SFC Chart</comment>
		<attribute name="TypeDescriptiveForm" value="  This function is used to freeze charts. No transition is evaluated and therefore no processing  is done in the chart even if valid transitions are TRUE.&#xA;&#xA;  Danger: FREEZECHART should not be used for error detection on controllers for machine&#xA;          tools or, process or material handling systems when they are running.&#xA;          Failure to observe this precaution could result in death or serious injury.&#xA;&#xA;  Whilst in a frozen state, active steps in the chart may be changed (using SFCCNTRL) or&#xA;  set for debug purposes.&#xA;&#xA;  The output FREEZE_O is TRUE when the chart is frozen.&#xA;&#xA;  Note: Output FREEZE_O shows the actual state of the chart but the chart can also be&#xA;        frozen by EFB SFCCNTRL or some other command (externally).&#xA;"></attribute>
		<attribute name="IsTypeHidden" value="FALSE"></attribute>
		<attribute name="TypeCodeCheckSumString" value="BBDC"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="E698"></attribute>
		<ExternalToolsOnly>
			<inputParameters>
				<variables name="CHARTREF" typeName="SFCCHART_STATE">
					<comment>Link to SFC-chart</comment>
					<attribute name="PositionPin" value="1"></attribute>
				</variables>
				<variables name="FREEZE_I" typeName="BOOL">
					<comment>Disable transition processing</comment>
					<attribute name="PositionPin" value="2"></attribute>
				</variables>
			</inputParameters>
			<outputParameters>
				<variables name="FREEZE_O" typeName="BOOL">
					<comment>Show value of FREEZE_I in effect</comment>
					<attribute name="PositionPin" value="2"></attribute>
				</variables>
			</outputParameters>
		</ExternalToolsOnly>
	</EFSource>
	<EFBSource nameOfEFBType="TON" version="1.00" dateTime="dt#2020-10-16-14:32:27">
		<comment>On delay</comment>
		<attribute name="TypeDescriptiveForm" value="  The function block is used as the On delay.  When the function block is called for the first time, the initial state of ET is &quot;0&quot;.&#xA;"></attribute>
		<attribute name="IsTypeHidden" value="FALSE"></attribute>
		<attribute name="IsTypeDiagnostic" value="FALSE"></attribute>
		<attribute name="TypeCodeCheckSumString" value="9363"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="16D2"></attribute>
		<ExternalToolsOnly>
			<inputParameters>
				<variables name="IN" typeName="BOOL">
					<comment>Start delay</comment>
					<attribute name="PositionPin" value="1"></attribute>
					<attribute name="IsPinDiagnosticable" value="0"></attribute>
				</variables>
				<variables name="PT" typeName="TIME">
					<comment>Preset delay time</comment>
					<attribute name="PositionPin" value="2"></attribute>
				</variables>
			</inputParameters>
			<outputParameters>
				<variables name="Q" typeName="BOOL">
					<comment>Delayed output</comment>
					<attribute name="PositionPin" value="1"></attribute>
				</variables>
				<variables name="ET" typeName="TIME">
					<comment>Internal time</comment>
					<attribute name="PositionPin" value="2"></attribute>
				</variables>
			</outputParameters>
		</ExternalToolsOnly>
	</EFBSource>
	<EFBSource nameOfEFBType="R_TRIG" version="1.00" dateTime="dt#2020-10-16-14:49:34">
		<comment>Rising edge detection</comment>
		<attribute name="TypeDescriptiveForm" value="  This function block is used for the detection of rising edges 0 -&gt; 1.&#xA;  Output Q becomes &quot;1&quot; if there is a transition from &quot;0&quot; to &quot;1&quot; at the CLK input.&#xA;  The output remains at &quot;1&quot; from one function block execution to the next (one cycle);&#xA;  the output subsequently returns to &quot;0&quot;.&#xA;&#xA;  Note: This function block is not available in the LD (Ladder Diagram) programming language,&#xA;        since the same functionality can be achieved there with the &quot;Contact - positive edge&quot;.&#xA;"></attribute>
		<attribute name="IsTypeHidden" value="FALSE"></attribute>
		<attribute name="IsTypeDiagnostic" value="FALSE"></attribute>
		<attribute name="TypeCodeCheckSumString" value="33B2"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="576B"></attribute>
		<ExternalToolsOnly>
			<inputParameters>
				<variables name="CLK" typeName="BOOL">
					<comment>Clock input</comment>
					<attribute name="PositionPin" value="1"></attribute>
					<attribute name="IsPinDiagnosticable" value="0"></attribute>
				</variables>
			</inputParameters>
			<outputParameters>
				<variables name="Q" typeName="BOOL">
					<comment>Output</comment>
					<attribute name="PositionPin" value="1"></attribute>
				</variables>
			</outputParameters>
		</ExternalToolsOnly>
	</EFBSource>
	<EFSource nameOfEFType="INITCHART" version="1.00" dateTime="dt#2020-10-16-14:44:19">
		<comment>reset all active steps, standardises start of chart</comment>
		<attribute name="TypeDescriptiveForm" value="  This function is used to reset all active steps and standardises starts of charts.&#xA;  Danger: INITCHART should not be used for error detection on controllers for machine&#xA;          tools or, process or material handling systems when they are running.&#xA;          Failure to observe this precaution could result in death or serious injury.&#xA;&#xA;  Note: INITCHART has the highest priority of all EFs and EFBs controlling SFC charts.&#xA;&#xA;  If the input INIT_I=1, the chart is stopped and all active steps are reset.&#xA;  This situation is maintained as long as the input INIT_I is true.&#xA;  On a falling edge at INIT_I the chart will be started in standardized status.&#xA;  Output INIT_O will indicate this for one scan.&#xA;&#xA;  Note: Output INIT_O shows the actual state of the chart but the chart may also be&#xA;        started by EFB SFCCNTRL or some other command (externally).&#xA;"></attribute>
		<attribute name="IsTypeHidden" value="FALSE"></attribute>
		<attribute name="TypeCodeCheckSumString" value="FBF1"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="E7F5"></attribute>
		<ExternalToolsOnly>
			<inputParameters>
				<variables name="CHARTREF" typeName="SFCCHART_STATE">
					<comment>Link to SFC-chart</comment>
					<attribute name="PositionPin" value="1"></attribute>
				</variables>
				<variables name="INIT_I" typeName="BOOL">
					<comment>Reset and start a SFC Chart</comment>
					<attribute name="PositionPin" value="2"></attribute>
				</variables>
			</inputParameters>
			<outputParameters>
				<variables name="INIT_O" typeName="BOOL">
					<comment>Show value of INIT_I in effect</comment>
					<attribute name="PositionPin" value="2"></attribute>
				</variables>
			</outputParameters>
		</ExternalToolsOnly>
	</EFSource>
	<EFSource nameOfEFType="SETSTEP" version="1.00" dateTime="dt#2020-10-16-14:44:19">
		<comment>Set one Step in a SFC Chart</comment>
		<attribute name="TypeDescriptiveForm" value="  This procedure is used to set a step in a chart.&#xA;  Danger: SETSTEP should not be used for error detection on controllers for machine&#xA;          tool or, process or material handling systems when they are running.&#xA;          Failure to observe this precaution could result in death or serious injury.&#xA;&#xA;  Note: This procedure may only be invoked in &quot;Multi-Token&quot; mode.&#xA;&#xA;  The step remains set as long as the procedure is processed.&#xA;"></attribute>
		<attribute name="IsTypeHidden" value="FALSE"></attribute>
		<attribute name="TypeCodeCheckSumString" value="8609"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="290D"></attribute>
		<ExternalToolsOnly>
			<inputParameters>
				<variables name="STEPNAME" typeName="SFCSTEP_STATE">
					<comment>Step to set</comment>
					<attribute name="PositionPin" value="1"></attribute>
				</variables>
				<variables name="CHARTREF" typeName="SFCCHART_STATE">
					<comment></comment>
					<attribute name="PositionPin" value="2"></attribute>
					<attribute name="IsVariableHidden" value="-1"></attribute>
				</variables>
			</inputParameters>
		</ExternalToolsOnly>
	</EFSource>

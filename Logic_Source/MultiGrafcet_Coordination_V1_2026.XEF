	<program>
		<identProgram name="G1_Voyants" type="section" task="MAST" SectionOrder="7"></identProgram>
		<STSource>(* Control of Voy1, Voy2, Voy3 based on active G1 steps *)

IF G1_0.X THEN
    Voy1 := TRUE;
    Voy2 := FALSE;
    Voy3 := FALSE;

ELSIF G1_1.X THEN
    Voy1 := FALSE;
    Voy2 := TRUE;
    Voy3 := FALSE;

ELSIF G1_2.X THEN
    Voy1 := FALSE;
    Voy2 := FALSE;
    Voy3 := TRUE;

ELSE
    (* Default state if no step is active *)
    Voy1 := FALSE;
    Voy2 := FALSE;
    Voy3 := FALSE;
END_IF;
</STSource>
	</program>
	<program>
		<identProgram name="Init_G1_Control" type="section" task="MAST" SectionOrder="8"></identProgram>
		<STSource>INIT_G1 := INIT_I;

</STSource>
	</program>
